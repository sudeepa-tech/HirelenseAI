# ---- ai-service ----
# Get a key at https://console.anthropic.com  (leave empty + MOCK_AI=true to demo free)
ANTHROPIC_API_KEY=
# Cheapest fast tier by default; override if you want a bigger model
AI_MODEL=claude-haiku-4-5
# Set true to run the whole product with zero AI spend (demo/testing)
MOCK_AI=false

# ---- interview-service ----
MAX_HISTORY=5
DATA_DIR=./data

# ---- gateway ----
PORT=8080
AI_SERVICE_URL=http://localhost:8081
INTERVIEW_SERVICE_URL=http://localhost:8082
CORS_ORIGIN=*
# Requests per minute per user. Dev defaults are generous (2000 API / 300 AI);
# production defaults (NODE_ENV=production) are 300 API / 30 AI.
# RATE_API_PER_MIN=300
# RATE_AI_PER_MIN=30
# RATE_LIMIT_DISABLED=true
